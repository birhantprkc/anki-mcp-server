{
  "mcpServers": {
    "anki-mcp-http": {
      "type": "http",
      "url": "http://localhost:3000"
    },
    "anki-mcp-stdio": {
      "type": "stdio",
      "command": "ankimcp",
      "args": [
        "--stdio"
      ],
      "env": {}
    },
    "claude-usage": {
      "command": "npx",
      "args": ["-y", "@anatoly314/claude-usage-mcp"]
    }
  }
}